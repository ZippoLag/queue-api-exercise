@page "/"
@using System.Net
@using System.Net.Http.Headers
@using System.Text
@inject HttpClient Http
@inject IConfiguration Configuration
@implements IAsyncDisposable

<PageTitle>Users API</PageTitle>

<div class="users-page">
    @if (_username is null)
    {
        <section class="auth-panel" aria-labelledby="sign-in-heading">
            <h1 id="sign-in-heading">Sign in</h1>

            @if (_error is not null)
            {
                <p role="alert" class="error">@_error</p>
            }

            <form @onsubmit="SignInAsync" @onsubmit:preventDefault="true">
                <div>
                    <label for="username">Username</label>
                    <input id="username" @bind="_usernameInput" autocomplete="username" />
                </div>
                <div>
                    <label for="password">Password</label>
                    <input id="password" type="password" @bind="_passwordInput" autocomplete="current-password" />
                </div>
                <button type="submit" disabled="@_busy">Sign in</button>
            </form>
        </section>
    }
    else
    {
        <section class="entities-panel" aria-labelledby="entities-heading">
            <header class="page-header">
                <h1 id="entities-heading">Entities</h1>
                <p>
                    Signed in as <strong>@_username</strong> (@(IsAdministrator ? "administrator" : "regular user")) —
                    <button @onclick="SignOutAsync">Sign out</button>
                </p>
            </header>

            <div class="polling-controls">
                <label for="polling-interval">Refresh interval (seconds)</label>
                <input id="polling-interval" type="number" min="1" step="1" @bind="_pollingIntervalInput" disabled="@_pollingActive" />
                <label for="polling-enabled">
                    <input id="polling-enabled" type="checkbox" checked="@_pollingActive" @onchange="PollingChangedAsync" />
                    Poll automatically
                </label>
            </div>

            @if (_error is not null)
            {
                <p role="alert" class="error">@_error</p>
            }

            @if (_entities is null)
            {
                <p>Loading…</p>
            }
            else
            {
                <div class="table-container">
                    <table>
                        <thead>
                            <tr>
                                <th>Id</th>
                                <th>Visible</th>
                                <th>Version</th>
                                <th>Updated</th>
                                <th>Payload</th>
                                @if (IsAdministrator)
                                {
                                    <th>Visibility</th>
                                }
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var entity in _entities)
                            {
                                <tr>
                                    <td>@entity.Id</td>
                                    <td>@entity.IsVisibleByAdmin</td>
                                    <td>@entity.LatestVersion</td>
                                    <td>@entity.UpdatedAt</td>
                                    <td>@entity.Payload</td>
                                    @if (IsAdministrator)
                                    {
                                        <td>
                                            <button @onclick="() => ToggleVisibilityAsync(entity)" disabled="@_busy">
                                                @(entity.IsVisibleByAdmin ? "Disable" : "Enable")
                                            </button>
                                        </td>
                                    }
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </section>
    }
</div>

@code {
    private const string EntitiesPath = "/entities";

    private string _usernameInput = string.Empty;
    private string _passwordInput = string.Empty;
    private string? _username;
    private string? _password;
    private string? _error;
    private bool _busy;
    private IReadOnlyList<EntityItem>? _entities;
    private string _pollingIntervalInput = "1";
    private bool _pollingActive;
    private CancellationTokenSource? _pollingCancellation;
    private Task? _pollingLoop;

    /// <summary>
    /// Whether the signed-in user is the administrator, derived from the username exactly as the API
    /// does: the configured <c>AdministratorUsername</c> (default <c>administrator</c>), ordinal compare
    /// (design D4 of change extra-ui).
    /// </summary>
    private bool IsAdministrator => string.Equals(
        _username,
        Configuration["AdministratorUsername"] ?? "administrator",
        StringComparison.Ordinal);

    /// <summary>
    /// Signs in with the entered credentials and loads the entity table; on failure the form stays with
    /// the API's <c>401</c>/<c>403</c> surfaced inline (design D3).
    /// </summary>
    private async Task SignInAsync()
    {
        _error = null;
        _busy = true;
        try
        {
            _username = _usernameInput;
            _password = _passwordInput;
            await LoadEntitiesAsync();
            if (_entities is null)
            {
                _username = null;
                _password = null;
            }
        }
        finally
        {
            _busy = false;
        }
    }

    /// <summary>
    /// Fetches the entity listing with the session's Basic credentials; non-success statuses clear the
    /// table and surface a descriptive inline error.
    /// </summary>
    private async Task LoadEntitiesAsync()
    {
        using var request = new HttpRequestMessage(HttpMethod.Get, EntitiesPath);
        request.Headers.Authorization = BasicHeader();

        using var response = await Http.SendAsync(request);
        if (response.IsSuccessStatusCode)
        {
            _entities = await response.Content.ReadFromJsonAsync<List<EntityItem>>() ?? [];
        }
        else
        {
            _entities = null;
            _error = response.StatusCode switch
            {
                HttpStatusCode.Unauthorized => "Sign-in failed: invalid username or password.",
                HttpStatusCode.Forbidden => "Sign-in failed: the cms-webhook user is reserved and cannot use this application.",
                _ => $"Sign-in failed: the server returned {(int)response.StatusCode}.",
            };
        }
    }

    /// <summary>
    /// Toggles one entity's administrator visibility through the existing enable/disable endpoints and
    /// re-fetches the table after a <c>204</c>; <c>404</c>/<c>401</c>/<c>403</c> render inline (design D5).
    /// </summary>
    private async Task ToggleVisibilityAsync(EntityItem entity)
    {
        _error = null;
        _busy = true;
        try
        {
            var command = entity.IsVisibleByAdmin ? "disable" : "enable";
            using var request = new HttpRequestMessage(HttpMethod.Post, $"{EntitiesPath}/{entity.Id}/{command}");
            request.Headers.Authorization = BasicHeader();

            using var response = await Http.SendAsync(request);
            if (response.StatusCode == HttpStatusCode.NoContent)
            {
                await LoadEntitiesAsync();
            }
            else
            {
                _error = response.StatusCode switch
                {
                    HttpStatusCode.Unauthorized => "Sign-in failed: invalid username or password.",
                    HttpStatusCode.Forbidden => "Not authorized to change entity visibility.",
                    HttpStatusCode.NotFound => $"Entity '{entity.Id}' no longer exists.",
                    _ => $"The server returned {(int)response.StatusCode}.",
                };
            }
        }
        finally
        {
            _busy = false;
        }
    }

    /// <summary>
    /// Clears the session state and returns to the sign-in form.
    /// </summary>
    private async Task PollingChangedAsync(ChangeEventArgs args)
    {
        if (args.Value is not bool enabled || !enabled)
        {
            _pollingActive = false;
            await StopPollingAsync();
            return;
        }

        if (!int.TryParse(_pollingIntervalInput, out var intervalSeconds) || intervalSeconds <= 0)
        {
            _pollingActive = false;
            return;
        }

        await StopPollingAsync();
        _pollingActive = true;
        _pollingCancellation = new CancellationTokenSource();
        _pollingLoop = PollEntitiesAsync(intervalSeconds, _pollingCancellation.Token);
    }

    /// <summary>
    /// Refreshes the authenticated entity table at the configured cadence without overlapping requests.
    /// </summary>
    private async Task PollEntitiesAsync(int intervalSeconds, CancellationToken cancellationToken)
    {
        using var timer = new PeriodicTimer(TimeSpan.FromSeconds(intervalSeconds));
        try
        {
            while (await timer.WaitForNextTickAsync(cancellationToken))
            {
                await LoadEntitiesAsync();
            }
        }
        catch (OperationCanceledException) when (cancellationToken.IsCancellationRequested)
        {
        }
    }

    private async Task StopPollingAsync()
    {
        _pollingCancellation?.Cancel();
        if (_pollingLoop is not null)
        {
            try
            {
                await _pollingLoop;
            }
            catch (OperationCanceledException)
            {
            }
        }

        _pollingCancellation?.Dispose();
        _pollingCancellation = null;
        _pollingLoop = null;
    }

    private async Task SignOutAsync()
    {
        _pollingActive = false;
        await StopPollingAsync();
        _username = null;
        _password = null;
        _usernameInput = string.Empty;
        _passwordInput = string.Empty;
        _entities = null;
        _error = null;
    }

    /// <inheritdoc />
    public async ValueTask DisposeAsync()
    {
        _pollingActive = false;
        await StopPollingAsync();
    }

    /// <summary>
    /// Builds the session's Basic <c>Authorization</c> header value; credentials live only in memory.
    /// </summary>
    private AuthenticationHeaderValue BasicHeader()
        => new("Basic", Convert.ToBase64String(Encoding.UTF8.GetBytes($"{_username}:{_password}")));

    /// <summary>
    /// One table row, mirroring the <c>GET /entities</c> response item shape (id, visibility flag,
    /// version, update time, payload as a JSON string).
    /// </summary>
    private sealed record EntityItem(
        string Id,
        bool IsVisibleByAdmin,
        int LatestVersion,
        DateTimeOffset UpdatedAt,
        string Payload);
}
