# Build-context exclusions for the container images.
#
# This file lives at the REPOSITORY ROOT because the build context is the
# repository root: both APIs reference projects outside their own directory
# (src/Shared/QueueApi.Auth, src/CmsWebhook/CmsWebhook.Domain), and Docker COPY
# cannot reach outside the context. Docker only reads <context>/.dockerignore,
# so per-project .dockerignore files would be ignored; this single file covers
# both images (task 1.3 of containerize-apis).

# Version control and tooling
.git/
.vscode/
.agents/
.openlore/
.devcontainer/

# Build output (never needed in the context; keeps the context small)
**/bin/
**/obj/
**/TestResults/
**/xUnit/

# Local SQLite stores (regenerated by scripts/init-db.sh / at API startup)
**/db/*.db*

# Generated sites, docs metadata, and workspace analysis stores
_site/
api/
workspaces/

# OpenSpec specs are not needed to build the images
openspec/

# Tests are not needed to build the images
tests/

# Logs and OS junk
**/*.log
logs/
.DS_Store
