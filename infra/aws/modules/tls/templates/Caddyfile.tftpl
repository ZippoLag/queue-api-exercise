# Generated by Terraform — do not edit by hand.

{
	# admin off hardens the node (no local config API); consequence: config changes must be
	# applied with `systemctl restart caddy` — `caddy reload` pushes config via the admin API.
	admin off
%{ if domain == "" }
	# Clients connecting to a bare IP send no SNI (RFC 6066: SNI is hostname-only), so Caddy
	# keys the handshake on the local destination address — which behind the EIP's 1:1 NAT
	# is the instance's PRIVATE IP, not the public IP the certificate is issued for. The
	# lookup finds no matching certificate and every handshake dies with "tlsv1 alert
	# internal error" (caddyserver/caddy#6344). default_sni pins certificate selection for
	# SNI-less handshakes to the public IP's certificate.
	default_sni ${public_ip}
%{ endif }
}

# Plain HTTP redirects to HTTPS: Basic Auth credentials must never travel unencrypted.
http:// {
	redir https://{host}{uri} permanent
}

%{ if domain != "" }
# Let's Encrypt certificates are issued and renewed automatically (HTTP-01 on :80).
https://cms.${domain} {
	reverse_proxy 127.0.0.1:8080
}

https://users.${domain} {
	reverse_proxy 127.0.0.1:8081
}
%{ else }
# Domainless variant: self-signed internal certificates keep HTTPS (and therefore Basic
# Auth safety) enforced over the public IP. Clients need -k or an imported CA.
# cms  → https://${public_ip}
# users → https://${public_ip}:8443
https://${public_ip} {
	tls internal
	reverse_proxy 127.0.0.1:8080
}

https://${public_ip}:8443 {
	tls internal
	reverse_proxy 127.0.0.1:8081
}
%{ endif }
