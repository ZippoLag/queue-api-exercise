{
  "name": "C# (.NET 9)",
  "build": { "dockerfile": "Dockerfile" },
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-dotnettools.csharp",
        "ms-dotnettools.csdevkit",
        "johnpapa.vscode-peacock",
        "rangav.vscode-thunder-client"
      ],
      "settings": {
        "terminal.integrated.defaultProfile.linux": "bash"
      }
    }
  },
  "forwardPorts": [5000, 5001, 8080, 8081],
  "remoteUser": "vscode"
}